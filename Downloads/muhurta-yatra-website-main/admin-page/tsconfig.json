{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../landing-page/node_modules/@types/react"],
      "react-dom": ["../landing-page/node_modules/@types/react-dom"],
      "react/jsx-runtime": ["../landing-page/node_modules/react/jsx-runtime"],
      "*": ["../landing-page/node_modules/*"]
    }
  },
  "include": ["src", "**/*.ts", "**/*.tsx"]
}
